    <!-- 查询角色 -->
    <select id="selectAll" resultType="Role">
        select * from `role`
        <where>
            <if test="roleName != '' and roleName != null">
                role_name like concat('%', #{roleName}, '%')
            </if>
        </where>
    </select>

    <!-- 新增角色 -->
    <insert id="insert" parameterType="Role" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO role (role_name, description, create_time)
        VALUES (#{roleName}, #{description}, #{createTime})
    </insert>

    <!-- 更新角色 -->
    <update id="updateById" parameterType="Role">
        UPDATE role
        <set>
            <if test="roleName != null and roleName != ''">
                role_name = #{roleName},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
        </set>
        WHERE role_id = #{roleId}
    </update>

    <!-- 根据ID删除角色 -->
    <delete id="deleteById" parameterType="long">
        DELETE FROM role WHERE role_id = #{roleId}
    </delete>

</mapper>